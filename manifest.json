{
  "manifest_version": 3,
  "name": "TipMNEE - Support Your Creators",
  "version": "1.0.0",
  "description": "Send tips to your favorite YouTube creators directly via crypto and manage your creator earnings.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "identity"
  ],
  "oauth2": {
    "client_id": "894402388292-ruvlnm0h77lq9ic90jfvs7tr38v680ht.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.readonly"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/inpage.bundle.js", "src/content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
